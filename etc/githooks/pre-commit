#!/usr/bin/env bash
# Git pre-commit hook (activated by etc/setup-hooks.sh): no commits on lean/master or
# on the primary branch (etc/primary-branch).
# Work on a branch and land it with etc/land.sh (AGENTS.md, Workflow).
# Humans who must commit on those branches directly can pass --no-verify; agents must not.
br=$(git symbolic-ref --short -q HEAD) || exit 0
primary=$(cat "$(git rev-parse --show-toplevel)/etc/primary-branch" 2>/dev/null || echo lean)
case "$br" in
  lean|master|"$primary")
    echo "perennial: refusing to commit on '$br'." >&2
    echo "perennial: work on a branch (git switch -c <topic>, or a worktree) and land it with etc/land.sh; see AGENTS.md, Workflow." >&2
    exit 1;;
esac
exit 0
