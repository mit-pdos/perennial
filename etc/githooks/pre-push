#!/usr/bin/env bash
# Git pre-push hook (activated by etc/setup-hooks.sh): lean, master and the primary
# branch (etc/primary-branch) move only
# through etc/land.sh, which sets PERENNIAL_LAND=1 for its one push after the
# branch has been built and reviewed. Also refuses non-fast-forward pushes to
# those branches. stdin: <local ref> <local sha> <remote ref> <remote sha> per ref.
[ "${PERENNIAL_LAND:-}" = 1 ] && exit 0
primary=$(cat "$(git rev-parse --show-toplevel)/etc/primary-branch" 2>/dev/null || echo lean)
rc=0
while read -r lref lsha rref rsha; do
  case "$rref" in
    refs/heads/lean|refs/heads/master|"refs/heads/$primary")
      echo "perennial: refusing to push to $rref directly." >&2
      echo "perennial: land the branch with etc/land.sh push (it merges origin/$primary in, builds, and requires the trusted-base review); see AGENTS.md, Workflow." >&2
      rc=1;;
  esac
done
exit $rc
