{
  "worktree": {
    "baseRef": "head"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/etc/hooks/session-start.sh\"",
            "timeout": 20,
            "statusMessage": "Checking branch workflow"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/etc/hooks/git-guard.sh\"",
            "timeout": 20,
            "statusMessage": "Guarding lean"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "EnterWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/etc/hooks/worktree-base.sh\"",
            "timeout": 60,
            "statusMessage": "Checking the worktree's base"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/etc/hooks/stop-nudge.sh\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
