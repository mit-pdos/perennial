/-
The reflection primitives: the instructions that `internal/reflectcore`'s primitive stubs use
(`FuncResolveAt`, `ConvertAt`, `FieldRefAt`, `ArraySliceAt`, `EqNilAt`, `TypeQuery`). Each is
an existing operation with its types read from interface values' dynamic types: its rule's
docstring names its Go template: the Go expression it evaluates, over type variables that the
rule instantiates at those dynamic types. A type `T` is passed as its token `any((*T)(nil))` (`tok`);
a primitive that reads only the type of its argument also accepts any `any((*T)(p))`. A
primitive is stuck at the arguments that no rule covers.

**The `layoutModelled` guard** (stated once, here). A type whose layout a Go model changes
(`layoutModelled`, generated by goose) is opaque to reflection: reflection observes a type's
representation, which for such a type is the model's, not Go's. So no rule reads one:
- `typeQuery` answers nothing about a `layoutModelled` type but `identByName` (its first line);
- a rule that reads a dynamic type's representation takes `[NotLayoutModelled t]` of that type
  (`FieldRefAt`, `ArraySliceAt`, `EqNilAt`), and `ConvertAt` takes `convertExposed … = false` of
  both types (a pointer conversion also reads the base types);
- `FuncResolveAt` takes no guard: it runs translated Go code at the type, which reads no
  representation of its own.
-/
module

public import Perennial.Golang.Defn.Interface
public import Perennial.Golang.Defn.Plain
public import Perennial.Golang.Defn.LayoutModelled

@[expose] public section

namespace Perennial

namespace go
section defs
variable [GooseExts] [GoLocalContext] [GoGlobalContext] [GoSemanticsFunctions]

/-- The token of `t`: the Go value `any((*t)(nil))`. -/
def tok (t : go.GoType) : GoInterface := interface.mkOk (go.PointerType t) #null

/-- The type arguments that the shape `s` gives for a dispatch argument of dynamic type `d`. -/
def shapeArgs : Shape → go.GoType → Option (List go.GoType)
  | .self, d => some [d]
  | .slice, d => match underlying d with | go.SliceType e => some [d, e] | _ => none
  | .map, d => match underlying d with | go.MapType k v => some [d, k, v] | _ => none
  | .ptr, d => match underlying d with | go.PointerType e => some [d, e] | _ => none
  | .chan c, d => match underlying d with
    | go.ChannelType c' e => if c = c' then some [d, e] else none
    | _ => none
  | .deref s, d => match d with | go.PointerType t => shapeArgs s t | _ => none

/-- `shapeArgs` of each shape and dispatch type, concatenated; none if the lengths differ. -/
def shapesArgs : List Shape → List go.GoType → Option (List go.GoType)
  | [], [] => some []
  | s :: shs, d :: ds => do
    let ts ← shapeArgs s d
    let ts' ← shapesArgs shs ds
    pure (ts ++ ts')
  | _, _ => none

/-- `FuncResolveAt`'s argument for the dispatch interfaces `is`: `#i` for one, right-nested pairs
for several. -/
def dispatchArgs : List GoInterfaceOk → val
  | [] => #()
  | [i] => #(GoInterface.ok i)
  | i :: is => PairV #(GoInterface.ok i) (dispatchArgs is)

/-- `reflect.Kind` of an underlying type. -/
noncomputable def kindOf (u : go.GoType) : Option Nat :=
  match u with
  | go.ArrayType _ _ => some 17
  | go.ChannelType _ _ => some 18
  | go.FunctionType _ => some 19
  | go.InterfaceType _ => some 20
  | go.MapType _ _ => some 21
  | go.PointerType _ => some 22
  | go.SliceType _ => some 23
  | go.StructType _ => some 25
  | _ => ([(go.bool, 1), (go.int, 2), (go.int8, 3), (go.int16, 4), (go.int32, 5), (go.int64, 6),
      (go.uint, 7), (go.uint8, 8), (go.uint16, 9), (go.uint32, 10), (go.uint64, 11),
      (go.uintptr, 12), (go.float32, 13), (go.float64, 14), (go.complex64, 15),
      (go.complex128, 16), (go.string, 24), («unsafe».Pointer, 26)].find?
        fun p => decide (p.1 = u)).map (·.2)

/-- `reflect.ChanDir`: `RecvDir` 1, `SendDir` 2, `BothDir` 3. -/
def chanDirOf : go.ChanDir → Nat
  | .recvonly => 1
  | .sendonly => 2
  | .sendrecv => 3

/-- `l[i]` for `0 ≤ i`. -/
def listAt {α : Type} (l : List α) (i : Int) : Option α :=
  if 0 ≤ i then l[i.toNat]? else none

/-- `reflect.StructField.Name`: goose names the blank fields `_#k`. -/
def fieldNameOf (fd : go.field_decl) : GoString :=
  if isBlankField (fieldDeclName fd) then go!"_" else fieldDeclName fd

def isEmbeddedField : go.field_decl → Bool
  | go.field_decl.Field _ _ _ => false
  | go.field_decl.Embedded _ _ _ => true

/-- `TypeQuery q`'s result for the type `t` and the index `i`. Ints are Go `int`s, types tokens.
Each row's Go template, for `T` the type `t` (`reflect.TypeFor[T]()`, `i` the index), is in its
comment. None for a `layoutModelled` `t` (the guard, in the module docstring), except
`identByName`, which reads only the type's name. -/
noncomputable def typeQuery (q : TypeQ) (t : go.GoType) (i : Int) : Option val :=
  if layoutModelled t ∧ q ≠ .identByName then none else
  match q, underlying t with
  -- `T.Kind()`
  | .kind, u => (kindOf u).map fun k => #(W64 k)
  -- the number of `T`'s type arguments
  | .numTypeArgs, _ => match t with
    | go.Named _ args => some #(W64 args.length)
    | _ => some #(W64 0)
  -- `T.Elem()`
  | .elem, go.PointerType e | .elem, go.SliceType e | .elem, go.ArrayType _ e
  | .elem, go.ChannelType _ e | .elem, go.MapType _ e => some #(tok e)
  -- `T.Key()`
  | .key, go.MapType k _ => some #(tok k)
  -- `T.Len()`
  | .len, go.ArrayType n _ => some #(W64 n)
  -- `T.ChanDir()`
  | .chanDir, go.ChannelType d _ => some #(W64 (chanDirOf d))
  -- `T.NumField()`
  | .numField, go.StructType fs => some #(W64 fs.length)
  -- `T.Field(i).Name`
  | .fieldName, go.StructType fs => (listAt fs i).map fun fd => #(fieldNameOf fd)
  -- `T.Field(i).Type`
  | .fieldType, go.StructType fs => (listAt fs i).map fun fd => #(tok (fieldDeclType fd))
  -- `T.Field(i).Anonymous`
  | .fieldEmbedded, go.StructType fs => (listAt fs i).map fun fd => #(isEmbeddedField fd)
  -- `T.NumIn()`
  | .numIn, go.FunctionType (go.Signature ins _ _) => some #(W64 ins.length)
  -- `T.In(i)`
  | .inType, go.FunctionType (go.Signature ins _ _) => (listAt ins i).map fun e => #(tok e)
  -- `T.NumOut()`
  | .numOut, go.FunctionType (go.Signature _ _ outs) => some #(W64 outs.length)
  -- `T.Out(i)`
  | .outType, go.FunctionType (go.Signature _ _ outs) => (listAt outs i).map fun e => #(tok e)
  -- `T.IsVariadic()`
  | .variadic, go.FunctionType (go.Signature _ v _) => some #v
  -- the token of `T`'s underlying type (Lean's: a defined struct type's has no tags)
  | .underlying, u => some #(tok u)
  -- `identByName t`: whether token equality is Go's type identity at `T`
  | .identByName, _ => some #(identByName t)
  | _, _ => none

/-- The underlying types at which `EqNilAt` compares with `nil`. -/
class inductive IsNilable : go.GoType → Prop
  | pointer (e : go.GoType) : IsNilable (go.PointerType e)
  | slice (e : go.GoType) : IsNilable (go.SliceType e)
  | map (k v : go.GoType) : IsNilable (go.MapType k v)
  | chan (d : go.ChanDir) (e : go.GoType) : IsNilable (go.ChannelType d e)
  | func (sig : go.signature) : IsNilable (go.FunctionType sig)
  | unsafePointer : IsNilable «unsafe».Pointer

attribute [instance] IsNilable.pointer IsNilable.slice IsNilable.map IsNilable.chan IsNilable.func
  IsNilable.unsafePointer

/-- `t` is not `layoutModelled`: the guard (module docstring) of the rules that read `t`'s
representation. A class, so that instance search finds it for the unnamed types (`rfl`). -/
class NotLayoutModelled (t : go.GoType) : Prop where
  not_layout_modelled : layoutModelled t = false

instance NotLayoutModelled.pointer (e : go.GoType) : NotLayoutModelled (go.PointerType e) := ⟨rfl⟩
instance NotLayoutModelled.slice (e : go.GoType) : NotLayoutModelled (go.SliceType e) := ⟨rfl⟩
instance NotLayoutModelled.map (k v : go.GoType) : NotLayoutModelled (go.MapType k v) := ⟨rfl⟩
instance NotLayoutModelled.chan (d : go.ChanDir) (e : go.GoType) :
    NotLayoutModelled (go.ChannelType d e) := ⟨rfl⟩
instance NotLayoutModelled.func (sig : go.signature) : NotLayoutModelled (go.FunctionType sig) :=
  ⟨rfl⟩
instance NotLayoutModelled.array (n : Int) (e : go.GoType) :
    NotLayoutModelled (go.ArrayType n e) := ⟨rfl⟩
instance NotLayoutModelled.struct (fs : List go.field_decl) :
    NotLayoutModelled (go.StructType fs) := ⟨rfl⟩
instance NotLayoutModelled.interface (elems : List go.InterfaceElem) :
    NotLayoutModelled (go.InterfaceType elems) := ⟨rfl⟩

/-- `ConvertAt`'s form of the guard (module docstring): a conversion from or to `t` reads `t`'s
underlying type, and for a pointer its base type's (`convert_pointer_same_underlying`). -/
def convertExposed (t : go.GoType) : Bool :=
  layoutModelled t || match underlying t with
    | go.PointerType e => layoutModelled e
    | _ => false

class ReflectSemantics : Prop where
  /-- `FuncResolve f ts` for the type arguments `ts` that the shapes `shs` give for the dispatch
  interfaces `is`. Go template: the function value `f[T1, …, Tn]` of the generic function `f`
  (a translated helper of `internal/reflectcore`), e.g. `load[T]` for a dispatch value of type
  `*T` and the shapes `[deref self]`. Not an instance: its premise is not found by instance
  search. -/
  func_resolve_at_step (shs : List Shape) (f : GoString) (is : List GoInterfaceOk)
      (ts : List go.GoType) (h : shapesArgs shs (is.map (·.ty)) = some ts) :
    ⟦FuncResolveAt shs f, dispatchArgs is⟧ ⤳ #(functions f ts)
  /-- Go template: `any(U(x))` for `x : T`, at `x`'s dynamic type `T = t` and the token's
  `U = u`. For a non-interface `u`, it is `Convert t u` at those types, stuck where no `Convert`
  rule steps (each `Convert` rule steps only on a conversion Go allows: `CRITERIA.md`; the
  known exceptions, type identities Lean does not keep: `docs/KNOWN_LIMITATIONS.md`); for an
  interface `u`, it is `any(x)`, where `t` implements `u` (`hi`: Go's rule, which
  `convert_to_interface` does not check). Not an instance: its premises are not found by
  instance search. -/
  convert_at_step {t u : go.GoType} (v : val) (l : Loc)
      (hi : isInterfaceType (underlying u) = true → typeSetContains t u = true)
      (ht : convertExposed t = false) (hu : convertExposed u = false) :
    ⟦ConvertAt, (#(interface.mkOk t v), #(interface.mkOk (go.PointerType u) #l))⟧ ⤳
      (if isInterfaceType (underlying u) then #(interface.mkOk t v)
      else Convert u go.any (Convert t u (Val v)))
  /-- Go template: `any(&(*p).f)` for `p : *S`, at `S = s`, `f` the `i`th field of the struct
  type `s`. Not an instance: its premises are not found by instance search.
  Not yet used by the reflect Go model (`goose/model/overlay`);
  planned for S2: `Value.Field`/`FieldByName`. -/
  field_ref_at_step {s : go.GoType} {fs : List go.field_decl} [s ↓u go.StructType fs]
      [NotLayoutModelled s] (l : Loc)
      (i : w64) (fd : go.field_decl) (hl : l ≠ null) (hi : 0 ≤ sint.Z i)
      (hfd : fs[sint.nat i]? = some fd) (hblank : isBlankField (fieldDeclName fd) = false) :
    ⟦FieldRefAt, (#(interface.mkOk (go.PointerType s) #l), #i)⟧ ⤳
      Convert (go.PointerType (fieldDeclType fd)) go.any
        (StructFieldRef s (fieldDeclName fd) (Val #l))
  /-- Go template: `any((*p)[:])` for `p : *A`, at `A = a`, an array type. Not an instance: its
  premise is not found by instance search.
  Not yet used by the reflect Go model (`goose/model/overlay`);
  planned for S2: `Value.Index` on arrays. -/
  array_slice_at_step {a e : go.GoType} {n : Int} [a ↓u go.ArrayType n e] [NotLayoutModelled a]
      (l : Loc)
      (hl : l ≠ null) :
    ⟦ArraySliceAt, #(interface.mkOk (go.PointerType a) #l)⟧ ⤳
      Convert (go.SliceType e) go.any (Slice (go.ArrayType n e) (#l, #(W64 0), #(W64 n)))
  /-- Go template: `x == nil` for `x : T`, at `x`'s dynamic type `T = t`, a pointer, slice, map,
  channel, function or `unsafe.Pointer` type (`IsNilable`). -/
  eq_nil_at_step {t u : go.GoType} [t ↓u u] [IsNilable u] [NotLayoutModelled t] (v : val)
      {z : val}
      [⟦GoZeroVal t, #()⟧ ⤳ Val z] :
    ⟦EqNilAt, #(interface.mkOk t v)⟧ ⤳ GoOp GoEquals t (Val v, Val z)
  /-- The fact `q` about the type `t` of a token. Go template: the row's, in `typeQuery`. Not an
  instance: its premise is not found by instance search. -/
  type_query_step (q : TypeQ) (t : go.GoType) (l : Loc) (i : w64) (v : val)
      (h : typeQuery q t (sint.Z i) = some v) :
    ⟦TypeQuery q, (#(interface.mkOk (go.PointerType t) #l), #i)⟧ ⤳ Val v

attribute [instance] ReflectSemantics.eq_nil_at_step
export ReflectSemantics (func_resolve_at_step convert_at_step field_ref_at_step
  array_slice_at_step eq_nil_at_step type_query_step)

end defs
end go

end Perennial
