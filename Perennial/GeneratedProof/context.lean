    AccessStrict (PROP := IProp GF)
      (typedPointsto (structFieldRef context.timerCtx.t go!"cancelCtx" l) v.cancelCtx' dq)
      (typedPointsto (structFieldRef context.timerCtx.t go!"cancelCtx" l) v.cancelCtx' dq)
      (typedPointsto l v dq) (typedPointsto l v dq) :=
 by
  solve_pointsto_access_struct

