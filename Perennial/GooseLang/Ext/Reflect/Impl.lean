/-
The reflection extension of GooseLang [Trusted definitions!].

The primitives of `internal/reflectcore` (`goose/model/overlay/internal/reflectcore/core.go`), on
which the Go models of `reflect` and `internal/reflectlite` are built; their stubs
(`Perennial/TrustedCode/internal/reflectcore.lean`) call the operations below
(`ExternalOp reflectExtName o v`). Each operation is an existing Go operation with its types read
from interface values' dynamic types; its case of `ReflectStep` names its Go template: the Go
expression it evaluates, over type variables instantiated at those dynamic types. A type `T` is
passed as its token `any((*T)(nil))` (`go.tok`); an operation that reads only the type of its
argument also accepts any `any((*T)(p))`.

* Stateless: no values, local or global state of its own; a step leaves the heap unchanged.
* A step reads the machine's type functions `tf` (`GoTypeFns`: `underlying`, `methodSet`), and
  nothing else of the Go context.
* At arguments no case covers there is no step: the operation is stuck.
* Evidence: `goose/model/reflect/harness` writes each case in Go over the real `reflect`
  (`reflectcore/core_harness.go`) and checks it against the Go operation of its template, and
  that it is stuck where Go panics.
* Static parameters: the `TypeQ` row is in the operation's name (`"TypeQuery.kind"`, ...,
  `TypeQ.ofOp`); `FuncResolveAt`'s function name and shapes are the first component of its
  argument (`go.funcAtArg f shs`).

**The `layoutModelled` guard.** A type whose layout a Go model changes (`go.layoutModelled`,
generated by goose) is opaque to reflection: reflection observes a type's representation, which
for such a type is the model's, not Go's. So no operation reads one:
- `typeQuery` answers nothing about a `layoutModelled` type but `identByName` (its first line);
- an operation that reads a dynamic type's representation requires `layoutModelled t = false` of
  that type (`FieldRefAt`, `ArraySliceAt`, `EqNilAt`), and `ConvertAt` requires
  `convertExposed … = false` of both types (a pointer conversion also reads the base types);
- `FuncResolveAt` has no guard: it runs translated Go code at the type, which reads no
  representation of its own.
-/
module

public import Perennial.Golang.Defn.Interface
public import Perennial.Golang.Defn.Plain
public import Perennial.Golang.Defn.LayoutModelled

@[expose] public section

namespace Perennial

namespace go

instance : DecidableEq ChanDir := fun a b => by
  cases a <;> cases b <;> first | exact isTrue rfl | exact isFalse nofun

/-- How the dynamic type `d` of a dispatch argument of `FuncResolveAt` gives type arguments
(`GoTypeFns.shapeArgs`). -/
inductive Shape where
  /-- `[d]` -/
  | self
  /-- `[d, e]` for `d`'s underlying type `[]e` -/
  | slice
  /-- `[d, k, v]` for `d`'s underlying type `map[k]v` -/
  | map
  /-- `[d, e]` for `d`'s underlying type `*e` -/
  | ptr
  /-- `[d, e]` for `d`'s underlying type `chan e` of direction `c` -/
  | chan (c : ChanDir)
  /-- `s` applied to `t`, for `d` the unnamed `*t` -/
  | deref (s : Shape)
deriving DecidableEq

/-- A fact about a type that `TypeQuery` reads (`GoTypeFns.typeQuery`). -/
inductive TypeQ where
  | kind | numTypeArgs | elem | key | len | chanDir | numField | fieldName | fieldType
  | fieldEmbedded | numIn | inType | numOut | outType | variadic | underlying | identByName
deriving DecidableEq

/-- The `TypeQ` of an operation name: `"TypeQuery.<q>"`. -/
def TypeQ.ofOp : String → Option TypeQ
  | "TypeQuery.kind" => some .kind
  | "TypeQuery.numTypeArgs" => some .numTypeArgs
  | "TypeQuery.elem" => some .elem
  | "TypeQuery.key" => some .key
  | "TypeQuery.len" => some .len
  | "TypeQuery.chanDir" => some .chanDir
  | "TypeQuery.numField" => some .numField
  | "TypeQuery.fieldName" => some .fieldName
  | "TypeQuery.fieldType" => some .fieldType
  | "TypeQuery.fieldEmbedded" => some .fieldEmbedded
  | "TypeQuery.numIn" => some .numIn
  | "TypeQuery.inType" => some .inType
  | "TypeQuery.numOut" => some .numOut
  | "TypeQuery.outType" => some .outType
  | "TypeQuery.variadic" => some .variadic
  | "TypeQuery.underlying" => some .underlying
  | "TypeQuery.identByName" => some .identByName
  | _ => none

section defs
variable [GooseExts] [GoGlobalContext]

/-- The token of `t`: the Go value `any((*t)(nil))`. -/
def tok (t : go.GoType) : GoInterface := interface.mkOk (go.PointerType t) #null

/-- `reflect.ChanDir`: `RecvDir` 1, `SendDir` 2, `BothDir` 3. -/
def chanDirOf : go.ChanDir → Nat
  | .recvonly => 1
  | .sendonly => 2
  | .sendrecv => 3

/-- A shape as a value: distinct integer literals for the shapes other than `deref`, and
`deref s` as `s`'s value paired with the unit literal. -/
def Shape.toVal : Shape → val
  | .self => LitV (LitInt 0)
  | .slice => LitV (LitInt 1)
  | .map => LitV (LitInt 2)
  | .ptr => LitV (LitInt 3)
  | .chan .recvonly => LitV (LitInt 4)
  | .chan .sendonly => LitV (LitInt 5)
  | .chan .sendrecv => LitV (LitInt 6)
  | .deref s => PairV (LitV LitUnit) s.toVal

/-- A list of shapes as a value: right-nested pairs, ending in the unit literal. -/
def shapesVal : List Shape → val
  | [] => LitV LitUnit
  | s :: shs => PairV s.toVal (shapesVal shs)

/-- The static part of `FuncResolveAt`'s argument: the generic function `f` and the shapes. -/
def funcAtArg (f : GoString) (shs : List Shape) : val := PairV #f (shapesVal shs)

/-- `FuncResolveAt`'s dispatch argument for the interfaces `is`: `#i` for one, right-nested
pairs for several. -/
def dispatchArgs : List GoInterfaceOk → val
  | [] => #()
  | [i] => #(GoInterface.ok i)
  | i :: is => PairV #(GoInterface.ok i) (dispatchArgs is)

end defs

/-- `reflect.Kind` of an underlying type. -/
noncomputable def kindOf (u : go.GoType) : Option Nat :=
  match u with
  | go.ArrayType _ _ => some 17
  | go.ChannelType _ _ => some 18
  | go.FunctionType _ => some 19
  | go.InterfaceType _ => some 20
  | go.MapType _ _ => some 21
  | go.PointerType _ => some 22
  | go.SliceType _ => some 23
  | go.StructType _ => some 25
  | _ => ([(go.bool, 1), (go.int, 2), (go.int8, 3), (go.int16, 4), (go.int32, 5), (go.int64, 6),
      (go.uint, 7), (go.uint8, 8), (go.uint16, 9), (go.uint32, 10), (go.uint64, 11),
      (go.uintptr, 12), (go.float32, 13), (go.float64, 14), (go.complex64, 15),
      (go.complex128, 16), (go.string, 24), («unsafe».Pointer, 26)].find?
        fun p => decide (p.1 = u)).map (·.2)

/-- `l[i]` for `0 ≤ i`. -/
def listAt {α : Type} (l : List α) (i : Int) : Option α :=
  if 0 ≤ i then l[i.toNat]? else none

/-- `reflect.StructField.Name`: goose names the blank fields `_#k`. -/
def fieldNameOf (fd : go.field_decl) : GoString :=
  if isBlankField (fieldDeclName fd) then go!"_" else fieldDeclName fd

def isEmbeddedField : go.field_decl → Bool
  | go.field_decl.Field _ _ _ => false
  | go.field_decl.Embedded _ _ _ => true

/-- The underlying types at which `EqNilAt` compares with `nil`. -/
class inductive IsNilable : go.GoType → Prop
  | pointer (e : go.GoType) : IsNilable (go.PointerType e)
  | slice (e : go.GoType) : IsNilable (go.SliceType e)
  | map (k v : go.GoType) : IsNilable (go.MapType k v)
  | chan (d : go.ChanDir) (e : go.GoType) : IsNilable (go.ChannelType d e)
  | func (sig : go.signature) : IsNilable (go.FunctionType sig)
  | unsafePointer : IsNilable «unsafe».Pointer

attribute [instance] IsNilable.pointer IsNilable.slice IsNilable.map IsNilable.chan IsNilable.func
  IsNilable.unsafePointer

end go

/-! ## Functions of the type functions `tf`

`GoTypeFns.underlying`/`methodSet` are the machine's; these read only them. -/

namespace GoTypeFns
variable (tf : GoTypeFns)

/-- Whether `t` is in the type set of `t'` (Go's "`t` implements `t'`" for an interface `t'`). -/
noncomputable def typeSetTermContains (t : go.GoType) (e : go.type_term) : Bool :=
  match e with
  | go.TypeTerm t' => decide (t = t')
  | go.TypeTermUnderlying t' => decide (tf.underlying t = t')

noncomputable def typeSetElemContains (t : go.GoType) (e : go.InterfaceElem) : Bool :=
  match e with
  | go.MethodElem m signature => decide (tf.methodSet t !! m = some signature)
  | go.TypeElem terms => terms.any (tf.typeSetTermContains t)

noncomputable def typeSetElemsContains (t : go.GoType) (elems : List go.InterfaceElem) : Bool :=
  elems.all (tf.typeSetElemContains t)

noncomputable def typeSetContains (t t' : go.GoType) : Bool :=
  match tf.underlying t' with
  | go.InterfaceType elems => tf.typeSetElemsContains t elems
  | _ => decide (t = t')

/-- Whether the underlying type of `t` is an interface type. -/
def isInterface (t : go.GoType) : Bool :=
  match tf.underlying t with | go.InterfaceType _ => true | _ => false

/-- The type arguments that the shape `s` gives for a dispatch argument of dynamic type `d`. -/
def shapeArgs : go.Shape → go.GoType → Option (List go.GoType)
  | .self, d => some [d]
  | .slice, d => match tf.underlying d with | go.SliceType e => some [d, e] | _ => none
  | .map, d => match tf.underlying d with | go.MapType k v => some [d, k, v] | _ => none
  | .ptr, d => match tf.underlying d with | go.PointerType e => some [d, e] | _ => none
  | .chan c, d => match tf.underlying d with
    | go.ChannelType c' e => if c = c' then some [d, e] else none
    | _ => none
  | .deref s, d => match d with | go.PointerType t => shapeArgs s t | _ => none

/-- `shapeArgs` of each shape and dispatch type, concatenated; none if the lengths differ. -/
def shapesArgs : List go.Shape → List go.GoType → Option (List go.GoType)
  | [], [] => some []
  | s :: shs, d :: ds => do
    let ts ← tf.shapeArgs s d
    let ts' ← shapesArgs shs ds
    pure (ts ++ ts')
  | _, _ => none

/-- `ConvertAt`'s form of the guard (module docstring): a conversion from or to `t` reads `t`'s
underlying type, and for a pointer its base type's (`convert_pointer_same_underlying`). -/
def convertExposed (t : go.GoType) : Bool :=
  go.layoutModelled t || match tf.underlying t with
    | go.PointerType e => go.layoutModelled e
    | _ => false

section typeQuery
variable [GooseExts] [GoGlobalContext]

/-- `TypeQuery q`'s result for the type `t` and the index `i`. Ints are Go `int`s, types tokens.
Each row's Go template, for `T` the type `t` (`reflect.TypeFor[T]()`, `i` the index), is in its
comment. None for a `layoutModelled` `t` (the guard, in the module docstring), except
`identByName`, which reads only the type's name. -/
noncomputable def typeQuery (q : go.TypeQ) (t : go.GoType) (i : Int) : Option val :=
  if go.layoutModelled t ∧ q ≠ .identByName then none else
  match q, tf.underlying t with
  -- `T.Kind()`
  | .kind, u => (go.kindOf u).map fun k => #(W64 k)
  -- the number of `T`'s type arguments
  | .numTypeArgs, _ => match t with
    | go.Named _ args => some #(W64 args.length)
    | _ => some #(W64 0)
  -- `T.Elem()`
  | .elem, go.PointerType e | .elem, go.SliceType e | .elem, go.ArrayType _ e
  | .elem, go.ChannelType _ e | .elem, go.MapType _ e => some #(go.tok e)
  -- `T.Key()`
  | .key, go.MapType k _ => some #(go.tok k)
  -- `T.Len()`
  | .len, go.ArrayType n _ => some #(W64 n)
  -- `T.ChanDir()`
  | .chanDir, go.ChannelType d _ => some #(W64 (go.chanDirOf d))
  -- `T.NumField()`
  | .numField, go.StructType fs => some #(W64 fs.length)
  -- `T.Field(i).Name`
  | .fieldName, go.StructType fs => (go.listAt fs i).map fun fd => #(go.fieldNameOf fd)
  -- `T.Field(i).Type`
  | .fieldType, go.StructType fs => (go.listAt fs i).map fun fd => #(go.tok (go.fieldDeclType fd))
  -- `T.Field(i).Anonymous`
  | .fieldEmbedded, go.StructType fs => (go.listAt fs i).map fun fd => #(go.isEmbeddedField fd)
  -- `T.NumIn()`
  | .numIn, go.FunctionType (go.Signature ins _ _) => some #(W64 ins.length)
  -- `T.In(i)`
  | .inType, go.FunctionType (go.Signature ins _ _) => (go.listAt ins i).map fun e => #(go.tok e)
  -- `T.NumOut()`
  | .numOut, go.FunctionType (go.Signature _ _ outs) => some #(W64 outs.length)
  -- `T.Out(i)`
  | .outType, go.FunctionType (go.Signature _ _ outs) => (go.listAt outs i).map fun e => #(go.tok e)
  -- `T.IsVariadic()`
  | .variadic, go.FunctionType (go.Signature _ v _) => some #v
  -- the token of `T`'s underlying type (Lean's: a defined struct type's has no tags)
  | .underlying, u => some #(go.tok u)
  -- `identByName t`: whether token equality is Go's type identity at `T`
  | .identByName, _ => some #(go.identByName t)
  | _, _ => none

end typeQuery
end GoTypeFns

/-! ## The extension -/

/-- The name of the reflection extension: the path of the Go package whose stubs call it. -/
abbrev reflectExtName : String := "internal/reflectcore"

/-- The reflection extension: no values, local or global state of its own. -/
def reflectExt : GooseExt where
  name := reflectExtName
  Val := Empty
  LocalState := Unit
  GlobalState := Unit

section step
variable [GooseExts] [GoGlobalContext]

/-- The step of the operation `o` on the argument `v`, at the type functions `tf`: the result
`e'`; the heap is unchanged (`ReflectStep`). -/
def ReflectOpStep (tf : GoTypeFns) (o : String) (v : val) (e' : Expr) : Prop :=
  match go.TypeQ.ofOp o with
  /- `"TypeQuery.<q>"`: the fact `q` about the type `t` of a token. Go template: the row's, in
  `typeQuery`. -/
  | some q => ∃ (t : go.GoType) (l : Loc) (i : w64) (w : val),
      v = PairV #(interface.mkOk (go.PointerType t) #l) #i ∧
      tf.typeQuery q t (sint.Z i) = some w ∧
      e' = Val w
  | none =>
  match o with
  /- `FuncResolve f ts` for the type arguments `ts` that the shapes `shs` give for the dispatch
  interfaces `is`. Go template: the function value `f[T1, …, Tn]` of the generic function `f`
  (a translated helper of `internal/reflectcore`), e.g. `load[T]` for a dispatch value of type
  `*T` and the shapes `[deref self]`. -/
  | "FuncResolveAt" => ∃ (f : GoString) (shs : List go.Shape) (is : List GoInterfaceOk)
      (ts : List go.GoType),
      v = PairV (go.funcAtArg f shs) (go.dispatchArgs is) ∧
      tf.shapesArgs shs (is.map (·.ty)) = some ts ∧
      e' = App (Val (GoInstruction (FuncResolve f ts))) (Val #())
  /- Go template: `any(U(x))` for `x : T`, at `x`'s dynamic type `T = t` and the token's
  `U = u`. For a non-interface `u`, it is `Convert t u` at those types, stuck where no `Convert`
  rule steps (each `Convert` rule steps only on a conversion Go allows: `CRITERIA.md`; the
  known exceptions, type identities Lean does not keep: `docs/KNOWN_LIMITATIONS.md`); for an
  interface `u`, it is `any(x)`, where `t` implements `u` (`hi`: Go's rule, which
  `convert_to_interface` does not check). -/
  | "ConvertAt" => ∃ (t u : go.GoType) (w : val) (l : Loc),
      v = PairV #(interface.mkOk t w) #(interface.mkOk (go.PointerType u) #l) ∧
      (tf.isInterface u = true → tf.typeSetContains t u = true) ∧
      tf.convertExposed t = false ∧ tf.convertExposed u = false ∧
      e' = (if tf.isInterface u then gl(#(interface.mkOk t w))
        else gl(Convert u go.any (Convert t u (Val w))))
  /- Go template: `any(&(*p).f)` for `p : *S`, at `S = s`, `f` the `i`th field of the struct
  type `s`. Not yet used by the reflect Go model (`goose/model/overlay`); planned for S2:
  `Value.Field`/`FieldByName`. -/
  | "FieldRefAt" => ∃ (s : go.GoType) (fs : List go.field_decl) (l : Loc) (i : w64)
      (fd : go.field_decl),
      v = PairV #(interface.mkOk (go.PointerType s) #l) #i ∧
      tf.underlying s = go.StructType fs ∧ go.layoutModelled s = false ∧
      l ≠ null ∧ 0 ≤ sint.Z i ∧ fs[sint.nat i]? = some fd ∧
      go.isBlankField (go.fieldDeclName fd) = false ∧
      e' = gl(Convert (go.PointerType (go.fieldDeclType fd)) go.any
        (StructFieldRef s (go.fieldDeclName fd) (Val #l)))
  /- Go template: `any((*p)[:])` for `p : *A`, at `A = a`, an array type. Not yet used by the
  reflect Go model (`goose/model/overlay`); planned for S2: `Value.Index` on arrays. -/
  | "ArraySliceAt" => ∃ (a e : go.GoType) (n : Int) (l : Loc),
      v = #(interface.mkOk (go.PointerType a) #l) ∧
      tf.underlying a = go.ArrayType n e ∧ go.layoutModelled a = false ∧ l ≠ null ∧
      e' = gl(Convert (go.SliceType e) go.any (Slice (go.ArrayType n e) (#l, #(W64 0), #(W64 n))))
  /- Go template: `x == nil` for `x : T`, at `x`'s dynamic type `T = t`, a pointer, slice, map,
  channel, function or `unsafe.Pointer` type (`IsNilable`); `nil` is `T`'s zero value. -/
  | "EqNilAt" => ∃ (t : go.GoType) (w : val),
      v = #(interface.mkOk t w) ∧
      go.IsNilable (tf.underlying t) ∧ go.layoutModelled t = false ∧
      e' = gl(GoOp GoEquals t (Val w, GoZeroVal t #()))
  | _ => False

/-- The step relation of the reflection extension: `ReflectOpStep`, with the heap unchanged. -/
def ReflectStep (tf : GoTypeFns) (o : String) (v : val) (h : GMap Loc (NonAtomic val))
    (_s : Unit) (_g : Unit) (e' : Expr) (h' : GMap Loc (NonAtomic val)) (_s' : Unit)
    (_g' : Unit) : Prop :=
  h' = h ∧ ReflectOpStep tf o v e'

end step

/-- The semantics of the reflection extension. It has no state, so no initial-state or crash
condition. -/
instance reflect_semantics : ExtSemantics reflectExt where
  step := ReflectStep
  crash _ _ := True

end Perennial
